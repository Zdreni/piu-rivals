# Copy to server/.env and fill in.
DATABASE_URL=mysql://piurivals:password@localhost:3306/piurivals

# API
GOOGLE_CLIENT_ID=<client id>.apps.googleusercontent.com
# Emails made admins when they sign in (comma-separated).
ADMIN_EMAILS=you@gmail.com

# Optional
# PORT=9876
# HOST=127.0.0.1
# CORS_ORIGIN=https://zdreni.github.io,http://localhost:5173
# SESSION_DAYS=30
# PIUSCORES_URL=https://piuscores.arroweclip.se
# SCRAPE_DELAY_MS=2000
# SCRAPER_BROWSER_CHANNEL=msedge
# SCRAPER_HEADLESS=true
# WORKER_POLL_MS=5000

# Tests: a database the API test may EMPTY (npm test skips the API test without it).
# TEST_DATABASE_URL=mysql://piurivals:password@localhost:3306/piurivals_test
